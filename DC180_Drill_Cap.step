#8241 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#8242 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#8243 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(5.E-04),#8240,
  'distance_accuracy_value','confusion accuracy');
#8244 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
